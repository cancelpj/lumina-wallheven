{
  "name": "wallhaven-electron",
  "version": "1.1.1",
  "description": "Lumina - A beautiful 4K wallpaper browser powered by wallhaven.cc (Electron port of wallhaven-tauri)",
  "author": "HelpToMe",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && electron-vite build",
    "build:mac": "node scripts/bump-version.mjs && npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vueuse/core": "^14.4.0",
    "lucide-vue-next": "^1.0.0",
    "material-symbols": "^0.44.12",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
